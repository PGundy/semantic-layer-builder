{
  "name": "semantic-layer-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["skills/*"],
  "scripts": {
    "sl": "bun skills/semantic-layer/scripts/sl.ts",
    "mcp": "bun skills/semantic-layer/scripts/mcp/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "fixtures": "bun fixtures/acme/generate.ts",
    "eval": "bun evals/runner/run.ts",
    "eval:smoke": "bun evals/smoke.ts",
    "verify": "sh scripts/verify.sh",
    "perf": "SL_PERF=1 bun test tests/perf --timeout 900000"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
