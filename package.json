{
  "name": "semantic-layer-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The semantic-layer-builder Claude Code plugin: the semlayer command, the /semlayer skill, five agents, hooks and an MCP server.",
  "scripts": {
    "semlayer": "bun skills/semantic-layer/scripts/semlayer.ts",
    "mcp": "bun skills/semantic-layer/scripts/mcp/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "fixtures": "bun fixtures/acme/generate.ts",
    "eval": "bun evals/runner/run.ts",
    "eval:smoke": "bun evals/smoke.ts",
    "verify": "bash scripts/verify.sh",
    "perf": "SEMLAYER_PERF=1 bun test tests/perf --timeout 900000"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
