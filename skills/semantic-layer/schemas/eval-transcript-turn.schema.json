{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evals/runs/<run_id>/transcript.jsonl line",
  "description": "One turn of an eval run; transcript.jsonl holds one per line, in order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn", "speaker", "text", "tokens", "timestamp"],
  "properties": {
    "turn": { "type": "integer", "minimum": 1 },
    "speaker": { "enum": ["skill", "owner"] },
    "text": { "type": "string", "description": "Redacted of anything the credential rules flag." },
    "tokens": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "description": "ISO 8601, from the run's clock." },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": { "command": { "type": "string" }, "exit_code": { "type": "integer" } }
      }
    }
  }
}
