{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "access.yaml",
  "description": "Roles, row filters and denials. Access fails closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "roles"
  ],
  "properties": {
    "status": {
      "enum": [
        "draft",
        "approved"
      ],
      "description": "Whether the owner has signed off this access file. Tools only write draft; sl approve sets approved."
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "description": "Who approved it. Required when status is approved."
    },
    "approved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date of approval, YYYY-MM-DD. Required when status is approved.",
      "format": "date"
    },
    "default_role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Role used when a user names none."
    },
    "user_attributes": {
      "type": "array",
      "description": "Attributes a user carries, referenced in row filters as {{ user.<name> }}.",
      "items": {
        "$ref": "#/$defs/user_attribute"
      }
    },
    "roles": {
      "type": "array",
      "description": "Roles; a user holds exactly one.",
      "items": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approved_by",
          "approved_at"
        ]
      }
    }
  ],
  "$defs": {
    "user_attribute": {
      "type": "object",
      "description": "A user attribute.",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Attribute name."
        },
        "type": {
          "enum": [
            "string",
            "number",
            "string_list",
            "number_list"
          ],
          "description": "Value type; a _list binds as a list for IN."
        },
        "description": {
          "type": "string",
          "description": "What the attribute holds."
        }
      }
    },
    "role": {
      "type": "object",
      "description": "A role.",
      "additionalProperties": false,
      "required": [
        "name",
        "allow"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Role name, unique."
        },
        "description": {
          "type": "string",
          "description": "Who holds this role and what it sees."
        },
        "allow": {
          "type": "object",
          "description": "What the role can see.",
          "additionalProperties": false,
          "required": [
            "models"
          ],
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Scope patterns over source.model names, such as warehouse.* or warehouse.orders."
            }
          }
        },
        "deny": {
          "type": "object",
          "description": "What is subtracted from allow.",
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Scope patterns over source.model names."
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
              },
              "description": "Fields as source.model.field."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "uniqueItems": true,
              "description": "Tags whose models, dimensions and measures are hidden."
            }
          }
        },
        "row_filters": {
          "type": "array",
          "description": "Predicates applied whenever a model is queried or joined in; several on one model combine with AND.",
          "items": {
            "type": "object",
            "description": "A row filter.",
            "additionalProperties": false,
            "required": [
              "model",
              "expr"
            ],
            "properties": {
              "model": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                "description": "Model as source.model."
              },
              "expr": {
                "type": "string",
                "minLength": 1,
                "description": "SQL predicate over the model's columns; {{ user.<attribute> }} binds as a parameter."
              }
            }
          }
        }
      }
    }
  }
}
