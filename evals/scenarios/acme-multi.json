{
  "name": "acme-multi",
  "description": "The Acme lake over a DuckDB connection with the structured persona, run by the interviewer with role agents: a batch analyst drafts the questions, a readback verifier writes and checks each readback, a golden builder writes and runs the goldens.",
  "fixture": "acme",
  "intake": {
    "path": "connection",
    "source": "lake",
    "dialect": "duckdb",
    "views": {
      "web_events": "read_parquet('{fixture}/data/lake/web_events/*.parquet')",
      "sessions": "read_parquet('{fixture}/data/lake/sessions.parquet')",
      "marketing_spend": "read_parquet('{fixture}/data/lake/marketing_spend.parquet')",
      "web_events_2024_archive": "read_parquet('{fixture}/data/lake/web_events_2024_archive.parquet')",
      "tmp_session_dedupe": "read_parquet('{fixture}/data/lake/tmp_session_dedupe.parquet')"
    }
  },
  "persona": "structured",
  "agents": "multi",
  "budgets": { "max_turns": 40, "max_tokens": 400000 },
  "opening": "Hi, I am Dana Ruiz, head of analytics at Acme. Our event lake is set up as the source lake in this semantic layer. Can you build the layer with me?",
  "script": "acme-multi.script.json",
  "grading": {
    "figures": "acme.figures.json",
    "selection": {
      "lake": ["web_events", "sessions", "marketing_spend"],
      "warehouse": ["fct_orders", "fct_order_items", "fct_refunds", "dim_customers", "dim_products", "dim_regions"]
    },
    "protected_columns": ["dim_customers.email", "dim_customers.phone", "dim_customers.first_name", "dim_customers.last_name"],
    "reference": "acme-structured",
    "max_interviewer_share": 0.4
  }
}
